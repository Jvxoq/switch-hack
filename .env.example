# Copy to .env, then run scripts/bootstrap_langfuse.sh. It generates the Langfuse secrets and keys. Set ANTHROPIC_* yourself for online demo runs.
# Never commit .env. Values here are placeholders only.

# --- Langfuse (self-hosted) -------------------------------------------------
LANGFUSE_IMAGE_TAG=4
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=CHANGEME
SALT=CHANGEME
ENCRYPTION_KEY=CHANGEME
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGEME
POSTGRES_DB=postgres
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=CHANGEME
REDIS_AUTH=CHANGEME
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=CHANGEME

# First-boot project and admin user. Langfuse creates them only on an empty database.
LANGFUSE_INIT_ORG_ID=CHANGEME
LANGFUSE_INIT_ORG_NAME=tripwire
LANGFUSE_INIT_PROJECT_ID=CHANGEME
LANGFUSE_INIT_PROJECT_NAME=tripwire
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=CHANGEME
LANGFUSE_INIT_PROJECT_SECRET_KEY=CHANGEME
LANGFUSE_INIT_USER_EMAIL=owner@example.com
LANGFUSE_INIT_USER_NAME=owner
LANGFUSE_INIT_USER_PASSWORD=CHANGEME

# Keys the detector and the demo agent use. The bootstrap copies them from LANGFUSE_INIT_PROJECT_*.
LANGFUSE_PUBLIC_KEY=CHANGEME
LANGFUSE_SECRET_KEY=CHANGEME

# --- Demo agent (online runs only; the compose file passes these through) ---
ANTHROPIC_API_KEY=CHANGEME
ANTHROPIC_MODEL=CHANGEME
# Which bug the one-shot demo run switches on, and how many runs it makes.
DEMO_BUG=loop
DEMO_RUNS=10

# --- Switch (detector) -------------------------------------------------------
# SWITCH_DRY_RUN=1 logs what would be posted instead of posting. Keep it 1 until Switch is set up.
SWITCH_DRY_RUN=1
SWITCH_PATH=agent
SWITCH_BASE_URL=
SWITCH_AGENT_ID=
SWITCH_ROOM_ID=
SWITCH_TOKEN=
SWITCH_STATUS_MODE=reply
